use jwt
use valk.json
use valk.time
use valk.crypto

value SECRET ("a-secret-nobody-else-has")

class Session {
    sub: String
    role: String
}

fn claims_of(values: Map[String]) json.Value {
    let object = json.new_object()
    let document: json.Value = object
    each values as value, name {
        document = document.set(name, json.new_string(value))
    }
    return document
}

test "Signing and reading" {
    let token = jwt.encode(claims_of(.{ "sub" => "user-1", "role" => "admin" }), SECRET)

    // Three parts, base64url, no padding
    assert(token.split(".").length == 3)
    assert(!token.contains("="))
    assert(!token.contains("+"))
    assert(!token.contains("/"))

    let claims = jwt.decode(token, SECRET) ! { println(E.message) assert(false) return }
    assert(claims.subject == "user-1")
    assert(claims.string("role") == "admin")
    assert(claims.has("role"))
    assert(!claims.has("nothing"))
    assert(claims.data["sub"].string == "user-1")

    // A token of a class of your own, read back into it
    let session_token = jwt.encode_of(Session { sub: "user-2", role: "member" }, SECRET)
    let session = jwt.decode_to[Session](session_token, SECRET) ! { println(E.message) assert(false) return }
    assert(session.sub == "user-2")
    assert(session.role == "member")

    // The other two algorithms
    let stronger = jwt.encode(claims_of(.{ "sub" => "user-3" }), SECRET, jwt.Algorithm.hs512)
    let read = jwt.decode(stronger, SECRET, .{ algorithm: jwt.Algorithm.hs512 }) ! { assert(false) return }
    assert(read.subject == "user-3")
}

test "A token that was changed is refused" {
    let token = jwt.encode(claims_of(.{ "sub" => "user-1", "role" => "member" }), SECRET)
    let parts = token.split(".")

    // Another secret does not verify it
    jwt.decode(token, "another-secret") ! {
        assert(error_is(E.code, signature))
    }

    // Claims that were rewritten, with the signature left as it was
    let tampered = json.new_object()
    let document: json.Value = tampered
    document = document.set("sub", json.new_string("user-1"))
    document = document.set("role", json.new_string("admin"))
    let forged = (parts.get(0) !? "") + "." + jwt.base64url_encode(document.encode()) + "." + (parts.get(2) !? "")
    jwt.decode(forged, SECRET) ! {
        assert(error_is(E.code, signature))
    }

    // A token that says it is unsigned
    let header = json.new_object()
    let header_value: json.Value = header
    header_value = header_value.set("alg", json.new_string("none"))
    header_value = header_value.set("typ", json.new_string("JWT"))
    let unsigned = jwt.base64url_encode(header_value.encode()) + "." + jwt.base64url_encode(document.encode()) + "."
    jwt.decode(unsigned, SECRET) ! {
        assert(error_is(E.code, algorithm))
        assert(E.message.contains("none"))
    }

    // A token signed with another algorithm than the one expected
    let other = jwt.encode(claims_of(.{ "sub" => "user-1" }), SECRET, jwt.Algorithm.hs512)
    jwt.decode(other, SECRET) ! {
        assert(error_is(E.code, algorithm))
    }

    // Nonsense
    jwt.decode("not-a-token", SECRET) ! {
        assert(error_is(E.code, syntax))
    }
    jwt.decode("a.b.c", SECRET) ! {
        assert(error_is(E.code, syntax))
        return
    }
    assert(false)
}

test "Expiry" {
    let now = time.unix_ms() / 1000

    // A token with a lifetime carries iat and exp
    let token = jwt.encode(claims_of(.{ "sub" => "user-1" }), SECRET, jwt.Algorithm.hs256, 3600)
    let claims = jwt.decode(token, SECRET) ! { println(E.message) assert(false) return }
    assert(claims.expires_at >= now + 3599)
    assert(claims.issued_at >= now - 5)
    assert(!claims.is_expired())

    // One that expired an hour ago
    let old = json.new_object()
    let document: json.Value = old
    document = document.set("sub", json.new_string("user-1"))
    document = document.set("exp", json.new_int((now - 3600).to(int)))
    let expired = jwt.encode(document, SECRET)
    jwt.decode(expired, SECRET) ! {
        assert(error_is(E.code, expired))
    }
    // Leeway does not stretch that far, but a second of clock difference is forgiven
    let just_gone = document.set("exp", json.new_int((now - 1).to(int)))
    jwt.decode(jwt.encode(just_gone, SECRET), SECRET, .{ leeway_seconds: 30 }) ! {
        println(E.message)
        assert(false)
        return
    }

    // One that is not valid yet
    let future = document.set("exp", json.new_int((now + 3600).to(int)))
    future = future.set("nbf", json.new_int((now + 600).to(int)))
    jwt.decode(jwt.encode(future, SECRET), SECRET) ! {
        assert(error_is(E.code, not_yet_valid))
    }

    // A token without exp is accepted, unless the caller says otherwise
    let forever = jwt.encode(claims_of(.{ "sub" => "user-1" }), SECRET)
    assert((jwt.decode(forever, SECRET) ! { assert(false) return }).expires_at == 0)
    jwt.decode(forever, SECRET, .{ require_expiry: true }) ! {
        assert(error_is(E.code, claim))
        return
    }
    assert(false)
}

test "Audience and issuer" {
    let document: json.Value = json.new_object()
    document = document.set("sub", json.new_string("user-1"))
    document = document.set("aud", json.new_string("the-api"))
    document = document.set("iss", json.new_string("the-login-service"))
    let token = jwt.encode(document, SECRET)

    let claims = jwt.decode(token, SECRET, .{ audience: "the-api", issuer: "the-login-service" }) ! {
        println(E.message)
        assert(false)
        return
    }
    assert(claims.audience == "the-api")
    assert(claims.issuer == "the-login-service")

    jwt.decode(token, SECRET, .{ audience: "another-api" }) ! {
        assert(error_is(E.code, claim))
        assert(E.message.contains("another-api"))
    }
    jwt.decode(token, SECRET, .{ issuer: "someone-else" }) ! {
        assert(error_is(E.code, claim))
        return
    }
    assert(false)
}

test "An audience list" {
    let document: json.Value = json.new_object()
    document = document.set("aud", json.new_array(Array[json.Value]{ json.new_string("web"), json.new_string("the-api") }))
    let token = jwt.encode(document, SECRET)

    let claims = jwt.decode(token, SECRET, .{ audience: "the-api" }) ! {
        println(E.message)
        assert(false)
        return
    }
    assert(claims.audience == "web")
    assert(claims.audiences.length == 2)
    jwt.decode(token, SECRET, .{ audience: "admin" }) ! {
        assert(error_is(E.code, claim))
        assert(E.message == "This token is for 'web', 'the-api', not for 'admin'")
        return
    }
    assert(false)
}

test "Reading a token without checking it" {
    let token = jwt.encode(claims_of(.{ "sub" => "user-1", "iss" => "the-login-service" }), SECRET)

    // No secret needed, and no promises made
    let claims = jwt.decode_unverified(token) ! { assert(false) return }
    assert(claims.subject == "user-1")
    assert(claims.issuer == "the-login-service")

    // Even a token nobody signed reads
    let unsigned = jwt.base64url_encode("{\"alg\":\"none\"}") + "." + jwt.base64url_encode("{\"sub\":\"whoever\"}") + "."
    let anything = jwt.decode_unverified(unsigned) ! { assert(false) return }
    assert(anything.subject == "whoever")
}

test "Rotating secrets by key id" {
    let old_secret = "the-secret-of-june"
    let new_secret = "the-secret-of-september"
    let secrets = jwt.SecretSet {}
    secrets.add("2026-09", new_secret)
    secrets.add("2026-06", old_secret)

    // The id goes into the header, and picks the secret that checks the token
    let fresh = jwt.encode(claims_of(Map[String]{ "sub" => "ada" }), new_secret, jwt.Algorithm.hs256, 3600, "2026-09")
    let header = jwt.base64url_decode(fresh.split(".").get(0) !? "") ! { assert(false) return }
    assert(header.contains("\"kid\":\"2026-09\""))
    let checked = jwt.decode_with_secrets(fresh, secrets) ! { assert(false) return }
    assert(checked.subject == "ada")
    let older = jwt.encode_of(Session { sub: "bob", role: "admin" }, old_secret, jwt.Algorithm.hs256, 3600, "2026-06")
    let checked_older = jwt.decode_with_secrets(older, secrets) ! { assert(false) return }
    assert(checked_older.subject == "bob")

    // A token signed with the secret of another id is forged
    let mixed = jwt.encode(claims_of(Map[String]{ "sub" => "eve" }), old_secret, jwt.Algorithm.hs256, 3600, "2026-09")
    let forged = false
    jwt.decode_with_secrets(mixed, secrets) ! { forged = error_is(E.code, signature) }
    assert(forged)

    // Without a `kid`, or with one the set does not hold: `key`
    let plain = jwt.encode(claims_of(Map[String]{ "sub" => "ada" }), new_secret)
    let no_id = false
    jwt.decode_with_secrets(plain, secrets) ! { no_id = error_is(E.code, key) }
    assert(no_id)
    let retired = jwt.encode(claims_of(Map[String]{ "sub" => "ada" }), "an-old-secret", jwt.Algorithm.hs256, 3600, "2025-12")
    let unknown = ""
    jwt.decode_with_secrets(retired, secrets) ! { unknown = E.message }
    assert(unknown == "No secret with id '2025-12' in the set")
    assert(secrets.key_ids().length == 2)
}

// The error code a token is refused with, or "accepted"
fn outcome(token: String, options: jwt.Options (.{})) String {
    jwt.decode(token, SECRET, options) ! {
        if error_is(E.code, syntax) : return "syntax"
        if error_is(E.code, signature) : return "signature"
        if error_is(E.code, algorithm) : return "algorithm"
        if error_is(E.code, expired) : return "expired"
        if error_is(E.code, not_yet_valid) : return "not_yet_valid"
        if error_is(E.code, claim) : return "claim"
        return "key"
    }
    return "accepted"
}

// A correctly signed HS256 token over a header and claims written by hand
fn signed(header: String, claims: String) String {
    let input = jwt.base64url_encode(header) + "." + jwt.base64url_encode(claims)
    return input + "." + jwt.base64url_encode(crypto.Hmac.sign(crypto.HashAlgorithm.sha256, SECRET, input))
}

value HEADER ("{\"alg\":\"HS256\",\"typ\":\"JWT\"}")

test "Malformed tokens are refused" {
    let token = signed(HEADER, "{\"sub\":\"x\"}")
    assert(outcome(token) == "accepted")
    let parts = token.split(".")

    // One token, one spelling: no padding, no standard base64 alphabet, no line breaks
    assert(outcome(token + "=") == "syntax")
    assert(outcome(token + "==") == "syntax")
    assert(outcome(parts[0] + "." + parts[1] + "." + parts[2].range(0, 10) + "\n" + parts[2].range(10, parts[2].length - 10)) == "syntax")
    let std = signed(HEADER, "{\"sub\":\"??>>>~~~\"}").split(".")
    let std_payload = std[1].replace("-", "+").replace("_", "/")
    let input = std[0] + "." + std_payload
    assert(std_payload.contains("+"))
    assert(outcome(input + "." + jwt.base64url_encode(crypto.Hmac.sign(crypto.HashAlgorithm.sha256, SECRET, input))) == "syntax")

    // The header and the claims are JSON objects
    assert(outcome(signed(HEADER, "[1]")) == "syntax")
    assert(outcome(signed(HEADER, "\"x\"")) == "syntax")
    assert(outcome(signed(HEADER, "")) == "syntax")
    assert(outcome(signed("[\"HS256\"]", "{}")) == "syntax")
    assert(outcome(signed(HEADER, "{\"sub\":")) == "syntax")

    // Empty parts and the wrong number of them
    assert(outcome(parts[0] + ".." + parts[2]) == "signature")
    assert(outcome(parts[0] + "." + parts[1] + ".") == "signature")
    assert(outcome(token + ".x") == "syntax")
    assert(outcome(parts[0] + "." + parts[1]) == "syntax")

    // Critical extensions are not understood, so refused
    assert(outcome(signed("{\"alg\":\"HS256\",\"crit\":[\"exp\"],\"exp\":1}", "{}")) == "syntax")

    // The algorithm is spelled exactly and must be there
    assert(outcome(signed("{\"alg\":\"hs256\"}", "{}")) == "algorithm")
    assert(outcome(signed("{\"alg\":\"HS256 \"}", "{}")) == "algorithm")
    assert(outcome(signed("{\"typ\":\"JWT\"}", "{}")) == "algorithm")
    assert(outcome(signed("{\"alg\":256}", "{}")) == "algorithm")

    // An empty secret is refused rather than checked
    let empty = false
    jwt.decode(token, "") ! { empty = error_is(E.code, key) }
    assert(empty)
}

test "Time claims at their limits" {
    let now = (time.unix_ms() / 1000).to(int)
    let with = fn(claims: String) String { return outcome(signed(HEADER, claims)) }

    // exp is the first second the token is no longer valid
    assert(with("{\"exp\":" + now + "}") == "expired")
    assert(with("{\"exp\":" + (now + 5) + "}") == "accepted")
    assert(outcome(signed(HEADER, "{\"exp\":" + (now - 10) + "}"), .{ leeway_seconds: 10 }) == "expired")
    assert(outcome(signed(HEADER, "{\"exp\":" + (now - 10) + "}"), .{ leeway_seconds: 30 }) == "accepted")

    // 0 and negative are long past, not absent
    assert(with("{\"exp\":0}") == "expired")
    assert(with("{\"exp\":-5}") == "expired")

    // Fractions of a second are allowed, and huge values are far away
    assert(with("{\"exp\":1000.5}") == "expired")
    assert(with("{\"exp\":" + (now + 100) + ".5}") == "accepted")
    assert(with("{\"exp\":1e30}") == "accepted")
    assert(with("{\"nbf\":" + (now + 100) + ".5}") == "not_yet_valid")
    assert(with("{\"nbf\":" + (now - 100) + ".5}") == "accepted")
    assert(with("{\"nbf\":1e30}") == "not_yet_valid")

    // A time claim that is not a number is refused, not ignored
    assert(with("{\"exp\":\"abc\"}") == "claim")
    assert(with("{\"exp\":\"1\"}") == "claim")
    assert(with("{\"exp\":null}") == "claim")
    assert(with("{\"nbf\":\"99999999999\"}") == "claim")
    assert(with("{\"iat\":true}") == "claim")

    let claims = jwt.decode_unverified(signed(HEADER, "{\"exp\":0}")) !!
    assert(claims.is_expired())
    assert(!(jwt.decode_unverified(signed(HEADER, "{}")) !!).is_expired())
}

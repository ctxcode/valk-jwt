use jwt
use valk.json
use valk.crypto

// Tokens and keys made with Python's `cryptography` package, an implementation of its own

fn options_for(algorithm: jwt.Algorithm) jwt.Options {
    return jwt.Options { algorithm: algorithm }
}

fn key_claims() json.Value {
    return json.from(Map[String]{ "sub" => "valk" })
}

fn fails_with(token: String, key: crypto.PublicKey, algorithm: jwt.Algorithm) String {
    jwt.verify(token, key, options_for(algorithm)) ! {
        if error_is(E.code, signature) : return "signature"
        if error_is(E.code, algorithm) : return "algorithm"
        if error_is(E.code, key) : return "key"
        return "other"
    }
    return "accepted"
}

test "Keys: tokens signed by another implementation verify" {
    let rsa = crypto.PublicKey.from_pem(PY_RSA_PUBLIC) !!
    let rsa_tokens = Array[String]{ PY_RS256, PY_RS384, PY_RS512, PY_PS256, PY_PS384, PY_PS512 }
    let rsa_algorithms = Array[jwt.Algorithm]{ jwt.Algorithm.rs256, jwt.Algorithm.rs384, jwt.Algorithm.rs512, jwt.Algorithm.ps256, jwt.Algorithm.ps384, jwt.Algorithm.ps512 }
    let i: uint = 0
    while i < rsa_tokens.length {
        let claims = jwt.verify(rsa_tokens[i], rsa, options_for(rsa_algorithms[i])) ! { println(E.message) assert(false) return }
        assert(claims.subject == "python" && claims.string("role") == "reader")
        i++
    }
    let es = crypto.PublicKey.from_pem(PY_ES256_PUBLIC) !!
    assert((jwt.verify(PY_ES256, es, options_for(jwt.Algorithm.es256)) !!).subject == "python")
    let ed = crypto.PublicKey.from_pem(PY_ED_PUBLIC) !!
    assert((jwt.verify(PY_EDDSA, ed, options_for(jwt.Algorithm.eddsa)) !!).subject == "python")

    // The algorithm the caller expects decides, whatever the key could check
    assert(fails_with(PY_RS256, rsa, jwt.Algorithm.ps256) == "algorithm")
    assert(fails_with(PY_ES256, rsa, jwt.Algorithm.es256) == "key")
    assert(fails_with(PY_EDDSA, rsa, jwt.Algorithm.eddsa) == "key")
}

test "Keys: signing and verifying with every algorithm" {
    let rsa = crypto.PrivateKey.generate_rsa() !!
    let keys = Array[crypto.PrivateKey]{ rsa, rsa, rsa, rsa, rsa, rsa, crypto.PrivateKey.generate_ec(crypto.Curve.p256) !!, crypto.PrivateKey.generate_ec(crypto.Curve.p384) !!, crypto.PrivateKey.generate_ec(crypto.Curve.p521) !!, crypto.PrivateKey.generate_ed25519() !! }
    let algorithms = Array[jwt.Algorithm]{ jwt.Algorithm.rs256, jwt.Algorithm.rs384, jwt.Algorithm.rs512, jwt.Algorithm.ps256, jwt.Algorithm.ps384, jwt.Algorithm.ps512, jwt.Algorithm.es256, jwt.Algorithm.es384, jwt.Algorithm.es512, jwt.Algorithm.eddsa }
    let other = crypto.PrivateKey.generate_ec(crypto.Curve.p256) !!
    let i: uint = 0
    while i < keys.length {
        let key = keys[i]
        let algorithm = algorithms[i]
        let public = key.public_key() !!
        let token = jwt.sign(key_claims(), key, algorithm, 3600, "key-1") !!
        let claims = jwt.verify(token, public, options_for(algorithm)) ! { println(E.message) assert(false) return }
        assert(claims.subject == "valk" && claims.expires_at > 0)
        assert(jwt.decode_unverified(token) !! .subject == "valk")

        // Another payload under the same signature
        let parts = token.split(".")
        let forged = parts[0] + "." + jwt.base64url_encode("{\"sub\":\"admin\"}") + "." + parts[2]
        assert(fails_with(forged, public, algorithm) == "signature")
        i++
    }
    // Another key of the right kind: the signature is not its own
    let es_token = jwt.sign(key_claims(), keys[6], jwt.Algorithm.es256) !!
    assert(fails_with(es_token, other.public_key() !!, jwt.Algorithm.es256) == "signature")

    // A key that does not fit the algorithm cannot sign or check with it
    let sign_errors = Array[String]{}
    jwt.sign(key_claims(), keys[7], jwt.Algorithm.es256) ! { sign_errors.append(error_is(E.code, key) ? "key" : "other") }
    jwt.sign(key_claims(), rsa, jwt.Algorithm.eddsa) ! { sign_errors.append(error_is(E.code, key) ? "key" : "other") }
    jwt.sign(key_claims(), rsa, jwt.Algorithm.hs256) ! { sign_errors.append(error_is(E.code, algorithm) ? "algorithm" : "other") }
    assert(sign_errors.length == 3 && sign_errors[0] == "key" && sign_errors[1] == "key" && sign_errors[2] == "algorithm")
    assert(fails_with(es_token, keys[7].public_key() !!, jwt.Algorithm.es256) == "key")
}

test "Keys: a public key is never used as an HMAC secret" {
    let rsa = crypto.PublicKey.from_pem(PY_RSA_PUBLIC) !!
    // The classic confusion: HS256 over the public key's PEM, as if it were the secret
    let forged = jwt.encode(json.from(Map[String]{ "sub" => "admin" }), PY_RSA_PUBLIC, jwt.Algorithm.hs256)
    assert(fails_with(forged, rsa, jwt.Algorithm.rs256) == "algorithm")
    assert(fails_with(forged, rsa, jwt.Algorithm.hs256) == "algorithm")
    let refused = false
    jwt.decode(PY_RS256, PY_RSA_PUBLIC, options_for(jwt.Algorithm.rs256)) ! { refused = error_is(E.code, algorithm) }
    assert(refused)
}

test "Keys: key sets from a JWKS document" {
    let keys = jwt.KeySet.from_jwks(PY_JWKS) !!
    let ids = keys.key_ids()
    assert(ids.length == 5)
    assert(ids.contains("rsa-1") && ids.contains("ec-ES512") && ids.contains("ed-1"))
    // Encryption keys, symmetric keys and keys without an id are left out
    assert(!ids.contains("enc-1") && !ids.contains("secret-1"))

    let tokens = Array[String]{ PY_RS256, PY_ES256, PY_ES384, PY_ES512, PY_EDDSA }
    let algorithms = Array[jwt.Algorithm]{ jwt.Algorithm.rs256, jwt.Algorithm.es256, jwt.Algorithm.es384, jwt.Algorithm.es512, jwt.Algorithm.eddsa }
    let i: uint = 0
    while i < tokens.length {
        let claims = jwt.verify_with_keys(tokens[i], keys, options_for(algorithms[i])) ! { println(E.message) assert(false) return }
        assert(claims.subject == "python")
        i++
    }
    // rsa-1 is limited to RS256 by its JWK
    let limited = false
    jwt.verify_with_keys(PY_PS256, keys, options_for(jwt.Algorithm.ps256)) ! { limited = error_is(E.code, algorithm) }
    assert(limited)

    let signer = crypto.PrivateKey.generate_ed25519() !!
    let unknown = false
    jwt.verify_with_keys(jwt.sign(key_claims(), signer, jwt.Algorithm.eddsa, 0, "nobody") !!, keys, options_for(jwt.Algorithm.eddsa)) ! { unknown = error_is(E.code, key) }
    assert(unknown)
    let no_id = false
    jwt.verify_with_keys(jwt.sign(key_claims(), signer, jwt.Algorithm.eddsa) !!, keys, options_for(jwt.Algorithm.eddsa)) ! { no_id = error_is(E.code, key) }
    assert(no_id)

    keys.add("mine", signer.public_key() !!)
    let own = jwt.sign(key_claims(), signer, jwt.Algorithm.eddsa, 0, "mine") !!
    assert((jwt.verify_with_keys(own, keys, options_for(jwt.Algorithm.eddsa)) !!).subject == "valk")

    let syntax = false
    jwt.KeySet.from_jwks("{\"no\":\"keys\"}") ! { syntax = error_is(E.code, syntax) }
    assert(syntax)
}


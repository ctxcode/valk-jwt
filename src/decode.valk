use valk.json
use valk.crypto

/// Reads a token, checks its signature, and returns what it says.
///
/// The signature is checked against the algorithm the caller expects, not against the one the
/// token names: a token cannot choose how it is verified, which is the mistake `alg: none`
/// attacks are built on. `exp` and `nbf` are checked as well, and the audience and issuer when
/// `options` names them.
///
/// ```valk
/// let claims = jwt.decode(token, secret) ! {
///     if error_is(E.code, expired) : return "your session has ended"
///     return "that token is not valid"
/// }
/// ```
///
/// This checks the HMAC algorithms, signed with a secret; tokens signed with a private key are
/// checked by `verify`. An `options.algorithm` of another kind throws `algorithm`, and an empty
/// secret throws `key`.
+ fn decode(token: String, secret: String, options: Options (.{})) Claims !Error {
    if !is_hmac(options.algorithm) {
        throw .algorithm { message: algorithm_name(options.algorithm) + " tokens are checked with a public key, through verify" }
    }
    // Anyone can sign with an empty secret
    if secret.length == 0 : throw .key { message: "The secret is empty" }
    let token_parts = split_token(token, options) !>
    if !crypto.Hmac.verify(hash_of(options.algorithm), secret, token_parts.signing_input, token_parts.signature) {
        throw .signature { message: "The signature of this token does not belong to it" }
    }
    return accept(token_parts, options) !>
}

/// Reads a token, checks its signature with a public key, and returns what it says.
///
/// For the RSA, ECDSA and EdDSA algorithms; `options.algorithm` says which one the token must
/// use, and the claims are checked as `decode` checks them. Throws `algorithm` for an HMAC
/// algorithm, which `decode` checks with a secret, and `key` when the key does not fit the
/// algorithm.
///
/// ```valk
/// let key = crypto.PublicKey.from_pem(pem) ! panic("not a key")
/// let claims = jwt.verify(token, key, jwt.Options { algorithm: jwt.Algorithm.rs256 }) ! panic("%{E.message}")
/// ```
+ fn verify(token: String, key: crypto.PublicKey, options: Options) Claims !Error {
    if is_hmac(options.algorithm) {
        throw .algorithm { message: algorithm_name(options.algorithm) + " tokens are checked with a secret, through decode" }
    }
    let algorithm = options.algorithm
    if !key_fits(algorithm, key.key_type(), key.bits()) {
        throw .key { message: "This key cannot check " + algorithm_name(algorithm) + " signatures" }
    }
    let token_parts = split_token(token, options) !>
    let signature = token_parts.signature
    // JWS writes ECDSA signatures as r and s side by side; the key checks DER
    if is_ecdsa(algorithm) {
        let size = (ec_bits(algorithm) + 7) / 8
        if signature.bytes != size * 2 {
            throw .signature { message: "The signature of this token does not belong to it" }
        }
        signature = crypto.ecdsa_signature_from_raw(signature) ! {
            throw .signature { message: "The signature of this token does not belong to it" }
        }
    }
    if !key.verify(signature_algorithm(algorithm), token_parts.signing_input, signature) {
        throw .signature { message: "The signature of this token does not belong to it" }
    }
    return accept(token_parts, options) !>
}

/// Reads a token into a class or struct of your own, checking it the way `verify` does.
+ fn verify_to[T](token: String, key: crypto.PublicKey, options: Options) T !Error {
    let claims = verify(token, key, options) !>
    return claims.to_type[T]() !>
}

class TokenParts {
    header: json.Value
    payload_text: String
    signing_input: String
    signature: String
}

// Splits a token and checks that its header names the algorithm the caller expects
fn split_token(token: String, options: Options) TokenParts !Error {
    let parts = token.split(".")
    if parts.length != 3 {
        throw .syntax { message: "A token is three parts separated by dots, this one has " + parts.length }
    }
    let header_text = parts.get(0) !? ""
    let payload_text = parts.get(1) !? ""
    let signature_text = parts.get(2) !? ""

    // The header says which algorithm the token claims to use; it is only trusted to disagree
    let header = read_object(header_text, "The header of this token is") !>
    // RFC 7515: extensions marked critical must be understood, and this package knows none
    if header.has("crit") {
        throw .syntax { message: "This token names critical header extensions that are not supported" }
    }
    let named = header.get("alg").string_value() !? ""
    let expected = algorithm_name(options.algorithm)
    if named != expected {
        throw .algorithm { message: "This token is signed with '" + named + "' where '" + expected + "' was expected" }
    }
    return TokenParts {
        header: header
        payload_text: payload_text
        signing_input: header_text + "." + payload_text
        signature: decode_part(signature_text) !>
    }
}

// A part of a token: base64url without padding, nothing else
fn decode_part(text: String) String !Error {
    if text.contains("=") : throw .syntax { message: "A part of the token is not valid base64url" }
    return base64url_decode(text) !>
}

// A header or the claims: a JSON object; `what` reads as "The header of this token is"
fn read_object(text: String, what: String) json.Value !Error {
    let value = json.decode(decode_part(text) !>) ! {
        throw .syntax { message: what + " not valid JSON" }
    }
    if !value.is_object : throw .syntax { message: what + " not a JSON object" }
    return value
}

// The claims of a token whose signature was found good, checked against `options`
fn accept(token_parts: TokenParts, options: Options) Claims !Error {
    let claims = read_claims(token_parts.payload_text) !>
    check_claims(claims, options) !>
    return claims
}

/// Reads a token into a class or struct of your own, checking it the way `decode` does.
+ fn decode_to[T](token: String, secret: String, options: Options (.{})) T !Error {
    let claims = decode(token, secret, options) !>
    return claims.to_type[T]() !>
}

/// Reads what a token says without checking anything at all.
///
/// Nothing that comes out of this may be trusted: anyone can write a token. It is for looking at
/// a token you already refused, or for reading the `iss` of one before you know which secret to
/// check it with.
+ fn decode_unverified(token: String) Claims !Error {
    let parts = token.split(".")
    if parts.length != 3 {
        throw .syntax { message: "A token is three parts separated by dots, this one has " + parts.length }
    }
    return read_claims(parts.get(1) !? "") !>
}

fn read_claims(payload_text: String) Claims !Error {
    let data = read_object(payload_text, "The claims of this token are") !>
    // `aud` is a string or a list of strings
    let audiences = Array[String]{}
    let aud = data.get("aud")
    if aud.is_array {
        each aud.array.values as item {
            let name = item.string_value() !? ""
            if name.length > 0 : audiences.append(name)
        }
    } else {
        let name = aud.string_value() !? ""
        if name.length > 0 : audiences.append(name)
    }
    return Claims {
        issuer: data.get("iss").string_value() !? ""
        subject: data.get("sub").string_value() !? ""
        audience: audiences.get(0) !? ""
        audiences: audiences
        id: data.get("jti").string_value() !? ""
        expires_at: claim_seconds(data, "exp")
        not_before: claim_seconds(data, "nbf")
        issued_at: claim_seconds(data, "iat")
        data: data
    }
}

// A time claim as a field: whole seconds, 0 when absent or not after the epoch
fn claim_seconds(data: json.Value, name: String) uint {
    let value = data.get(name).float_value() !? 0.0
    if value < 1.0 : return 0
    if value >= 18446744073709549568.0 : return 18446744073709549568.0.to(uint)
    return value.to(uint)
}

// A time claim for checking: null when absent; a value that is not a number is refused
fn time_claim(data: json.Value, name: String) ?float !Error {
    if !data.has(name) : return null
    return data.get(name).float_value() ! {
        throw .claim { message: "The '" + name + "' of this token is not a number of seconds" }
    }
}

fn check_claims(claims: Claims, options: Options) !Error {
    let now = now_seconds().to(float)
    let leeway = options.leeway_seconds.to(float)

    let exp = time_claim(claims.data, "exp") !>
    if isset(exp) {
        if now >= exp + leeway {
            throw .expired { message: "This token expired at " + claims.expires_at }
        }
    } else if options.require_expiry {
        throw .claim { message: "This token has no 'exp', which is required here" }
    }

    let nbf = time_claim(claims.data, "nbf") !>
    if isset(nbf) && now + leeway < nbf {
        throw .not_yet_valid { message: "This token is not valid before " + claims.not_before }
    }
    time_claim(claims.data, "iat") !>

    if options.audience.length > 0 && !claims.audiences.contains(options.audience) {
        throw .claim { message: "This token is for '" + claims.audiences.join("', '") + "', not for '" + options.audience + "'" }
    }
    if options.issuer.length > 0 && claims.issuer != options.issuer {
        throw .claim { message: "This token is from '" + claims.issuer + "', not from '" + options.issuer + "'" }
    }
}

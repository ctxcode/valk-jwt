use valk.json
use valk.crypto

/// Public keys by key id, as an OAuth or OpenID Connect provider publishes them in a JWKS
/// document, for `verify_with_keys`.
///
/// ```valk
/// let keys = jwt.KeySet.from_jwks(jwks_text) ! panic("%{E.message}")
/// let claims = jwt.verify_with_keys(token, keys, jwt.Options { algorithm: jwt.Algorithm.rs256 }) ! panic("%{E.message}")
/// ```
+ class KeySet {
    - keys: Map[crypto.PublicKey] (.{})
    // The `alg` a key is limited to, when its JWK names one
    - algorithms: Map[String] (.{})

    /// Reads a JWKS document, `{"keys": [...]}`.
    ///
    /// Keys without a `kid`, keys for encryption (`use` other than `sig`) and keys of a type
    /// `crypto.PublicKey.from_jwk` does not read are left out, so a document may list more than
    /// this package uses. Throws `syntax` when the text is not a JWKS document.
    + static fn from_jwks(text: String) KeySet !Error {
        let document = json.decode(text) ! {
            throw .syntax { message: "The key set is not valid JSON" }
        }
        let list = document.get_array("keys") ! {
            throw .syntax { message: "The key set has no 'keys' list" }
        }
        let set = KeySet {}
        each list.values as item {
            let id = item.get("kid").string_value() !? ""
            if id.length == 0 : continue
            let usage = item.get("use").string_value() !? "sig"
            if usage != "sig" : continue
            let key = crypto.PublicKey.from_jwk(item.encode()) ! continue
            set.keys.set(id, key)
            let algorithm = item.get("alg").string_value() !? ""
            if algorithm.length > 0 : set.algorithms.set(id, algorithm)
        }
        return set
    }

    /// Adds `key` under `key_id`, replacing a key with that id.
    + fn add(key_id: String, key: crypto.PublicKey) {
        this.keys.set(key_id, key)
        this.algorithms.remove(key_id)
    }

    /// Returns the key with id `key_id`, or null.
    + fn get(key_id: String) ?crypto.PublicKey {
        return this.keys.get(key_id) !? null
    }

    /// Returns the ids of the keys in the set.
    + fn key_ids() Array[String] {
        return this.keys.keys()
    }
}

/// Checks a token with the key its `kid` names in `keys`, as `verify` checks it with one key.
///
/// Throws `key` when the token has no `kid` or the set has no key with it, and `algorithm`
/// when the key's JWK is limited to another algorithm than `options.algorithm`.
+ fn verify_with_keys(token: String, keys: KeySet, options: Options) Claims !Error {
    let id = token_key_id(token) !>
    let key = keys.get(id) ?! throw .key { message: "No key with id '" + id + "' in the key set" }
    let limited = keys.algorithms.get(id) !? ""
    let expected = algorithm_name(options.algorithm)
    if limited.length > 0 && limited != expected {
        throw .algorithm { message: "Key '" + id + "' is for " + limited + ", not for " + expected }
    }
    return verify(token, key, options) !>
}

// The `kid` in the header of `token`; throws `key` when it names none
fn token_key_id(token: String) String !Error {
    let header_text = token.split(".").get(0) !? ""
    let header = json.decode(base64url_decode(header_text) !>) ! {
        throw .syntax { message: "The header of this token is not valid JSON" }
    }
    let id = header.get("kid").string_value() !? ""
    if id.length == 0 : throw .key { message: "This token names no key ('kid')" }
    return id
}

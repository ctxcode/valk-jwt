use valk.crypto
use valk.json
use valk.time

/// The algorithms this package signs and verifies with.
///
/// The HMAC ones (`hs*`) sign and verify with one secret, through `encode` and `decode`. The
/// others sign with a private key and verify with its public key, through `sign` and
/// `verify`: RSA with PKCS#1 v1.5 (`rs*`) or PSS padding (`ps*`), ECDSA on P-256, P-384 and
/// P-521 (`es256`, `es384`, `es512`), and Ed25519 (`eddsa`).
+ enum Algorithm {
    hs256
    hs384
    hs512
    rs256
    rs384
    rs512
    ps256
    ps384
    ps512
    es256
    es384
    es512
    eddsa
}

/// What a token says.
///
/// The claims the standard names are read into their own fields; `data` holds the whole object,
/// including whatever else was put in it.
///
/// ```valk
/// let claims = jwt.decode(token, secret) ! panic("%{E.message}")
/// println(claims.subject)                       // "sub"
/// println(claims.data["role"].string)           // a claim of your own
/// ```
+ class Claims {
    /// `iss`: who made the token.
    + issuer: String ("")
    /// `sub`: who the token is about.
    + subject: String ("")
    /// `aud`: who the token is for; the first one when `aud` is a list.
    + audience: String ("")
    /// Every `aud` value: one for a plain `aud`, all of them for a list.
    + audiences: Array[String] (.{})
    /// `jti`: the id of the token.
    + id: String ("")
    /// `exp`: the second after which the token is no longer valid, or 0 when it never expires.
    + expires_at: uint (0)
    /// `nbf`: the second before which the token is not valid yet, or 0.
    + not_before: uint (0)
    /// `iat`: the second the token was made, or 0.
    + issued_at: uint (0)
    /// Everything the token says, the claims above included.
    + data: json.Value

    /// Returns a claim by name, json null when it is not there.
    + fn get(name: String) json.Value {
        return this.data.get(name)
    }
    /// Returns a claim as text, or "" when it is not there.
    + fn string(name: String) String {
        return this.data.get(name).string_value() !? ""
    }
    /// Returns a claim as a number, or 0.
    + fn int(name: String) int {
        return this.data.get(name).int_value() !? 0
    }
    /// Returns a claim as a bool, or false.
    + fn bool(name: String) bool {
        return this.data.get(name).bool_value() !? false
    }
    /// Returns whether the token says anything about this claim.
    + fn has(name: String) bool {
        return this.data.has(name)
    }

    /// Returns whether the token is expired, allowing for `leeway_seconds` of clock difference.
    + fn is_expired(leeway_seconds: uint (0)) bool {
        if this.expires_at == 0 : return false
        return now_seconds() > this.expires_at + leeway_seconds
    }

    /// Reads the claims into a class or struct of your own, as `json.Value.to_type` does.
    + fn to_type[T]() T !Error {
        return this.data.to_type[T]() ! {
            throw .claim { message: "The claims of this token do not fit the type they were read into" }
        }
    }
}

/// What a token has to satisfy to be accepted.
///
/// The algorithm is checked against what the caller expects rather than against what the token
/// says, which is what keeps a token from choosing how it is verified.
+ class Options {
    /// The algorithm the token must be signed with.
    + algorithm: Algorithm (Algorithm.hs256)
    /// How much clock difference to allow when checking `exp` and `nbf`, in seconds.
    + leeway_seconds: uint (0)
    /// The audience the token must carry, or "" to accept any. When `aud` is a list, the
    /// audience has to be one of its values.
    + audience: String ("")
    /// The issuer the token must carry, or "" to accept any.
    + issuer: String ("")
    /// Whether a token without `exp` is refused.
    + require_expiry: bool (false)
}

fn now_seconds() uint {
    return time.unix_ms() / 1000
}

fn algorithm_name(algorithm: Algorithm) String {
    if algorithm == Algorithm.hs384 : return "HS384"
    if algorithm == Algorithm.hs512 : return "HS512"
    if algorithm == Algorithm.rs256 : return "RS256"
    if algorithm == Algorithm.rs384 : return "RS384"
    if algorithm == Algorithm.rs512 : return "RS512"
    if algorithm == Algorithm.ps256 : return "PS256"
    if algorithm == Algorithm.ps384 : return "PS384"
    if algorithm == Algorithm.ps512 : return "PS512"
    if algorithm == Algorithm.es256 : return "ES256"
    if algorithm == Algorithm.es384 : return "ES384"
    if algorithm == Algorithm.es512 : return "ES512"
    if algorithm == Algorithm.eddsa : return "EdDSA"
    return "HS256"
}

fn is_hmac(algorithm: Algorithm) bool {
    return algorithm == Algorithm.hs256 || algorithm == Algorithm.hs384 || algorithm == Algorithm.hs512
}

fn is_ecdsa(algorithm: Algorithm) bool {
    return algorithm == Algorithm.es256 || algorithm == Algorithm.es384 || algorithm == Algorithm.es512
}

fn signature_algorithm(algorithm: Algorithm) crypto.SignatureAlgorithm {
    if algorithm == Algorithm.rs384 : return crypto.SignatureAlgorithm.rsa_pkcs1_sha384
    if algorithm == Algorithm.rs512 : return crypto.SignatureAlgorithm.rsa_pkcs1_sha512
    if algorithm == Algorithm.ps256 : return crypto.SignatureAlgorithm.rsa_pss_sha256
    if algorithm == Algorithm.ps384 : return crypto.SignatureAlgorithm.rsa_pss_sha384
    if algorithm == Algorithm.ps512 : return crypto.SignatureAlgorithm.rsa_pss_sha512
    if algorithm == Algorithm.es256 : return crypto.SignatureAlgorithm.ecdsa_sha256
    if algorithm == Algorithm.es384 : return crypto.SignatureAlgorithm.ecdsa_sha384
    if algorithm == Algorithm.es512 : return crypto.SignatureAlgorithm.ecdsa_sha512
    if algorithm == Algorithm.eddsa : return crypto.SignatureAlgorithm.ed25519
    return crypto.SignatureAlgorithm.rsa_pkcs1_sha256
}

// The curve an ES algorithm is defined on, and its size in bits
fn ec_curve(algorithm: Algorithm) crypto.Curve {
    if algorithm == Algorithm.es384 : return crypto.Curve.p384
    if algorithm == Algorithm.es512 : return crypto.Curve.p521
    return crypto.Curve.p256
}
fn ec_bits(algorithm: Algorithm) uint {
    if algorithm == Algorithm.es384 : return 384
    if algorithm == Algorithm.es512 : return 521
    return 256
}

// Whether a key of `key_type` and `bits` can sign or verify with `algorithm`
fn key_fits(algorithm: Algorithm, key_type: crypto.KeyType, bits: uint) bool {
    if algorithm == Algorithm.eddsa : return key_type == crypto.KeyType.ed25519
    if is_ecdsa(algorithm) : return key_type == crypto.KeyType.ec && bits == ec_bits(algorithm)
    return key_type == crypto.KeyType.rsa
}

fn hash_of(algorithm: Algorithm) crypto.HashAlgorithm {
    if algorithm == Algorithm.hs384 : return crypto.HashAlgorithm.sha384
    if algorithm == Algorithm.hs512 : return crypto.HashAlgorithm.sha512
    return crypto.HashAlgorithm.sha256
}
